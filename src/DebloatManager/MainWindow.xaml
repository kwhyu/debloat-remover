<ui:FluentWindow x:Class="DebloatManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:conv="clr-namespace:DebloatManager.Converters"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DebloatManager" Width="1080" Height="720" MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True" Icon="/Assets/app.ico"
                 Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DebloatManager" />

        <DockPanel Grid.Row="1" Margin="12,4,12,10" LastChildFill="False">
            <ui:TextBox Width="280" PlaceholderText="Search name or publisher"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <ComboBox Width="150" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Margin="0,0,8,0" />
            <ComboBox Width="120" ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding SelectedRiskFilter}" />

            <ui:Button DockPanel.Dock="Right" Content="Legal" Command="{Binding ShowLegalCommand}" Margin="8,0,0,0" />
            <ui:Button DockPanel.Dock="Right" Content="Log" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
            <ui:Button DockPanel.Dock="Right" Content="Restore point" Command="{Binding CreateRestorePointCommand}" Margin="8,0,0,0" />
            <ui:Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding ScanCommand}" />
        </DockPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" MinHeight="3"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="32"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                  RowBackground="{StaticResource WindowBrush}" AlternatingRowBackground="{StaticResource WindowBrush}"
                  BorderThickness="0,1,0,1" BorderBrush="{StaticResource BorderBrush}"
                  ColumnHeaderStyle="{StaticResource ColumnHeader}" CellStyle="{StaticResource Cell}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanRemove}" MinWidth="0" Padding="0" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.4*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Origin" Binding="{Binding OriginLabel}" Width="90" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="Risk" Width="90" SortMemberPath="Risk">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Risk}" VerticalAlignment="Center"
                                       Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="14,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding SelectedItem.Name, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding SelectedItem.Identifier, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding SelectedItem.Notes}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem.Notes}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SelectedItem.OriginSummary}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectedItem.SourceDetails}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectedItem.RiskSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectedItem.RecoveryHint}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="12,10" LastChildFill="False">
            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="2,0,14,0" />
            <ui:Button Content="Select safe items" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" />
            <ui:Button DockPanel.Dock="Right" Content="Remove selected" Appearance="Primary" Command="{Binding RemoveSelectedCommand}" />
        </DockPanel>

        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" Padding="14,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,0"
                           Text="{Binding VisibleCount, StringFormat='{}{0} items'}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
