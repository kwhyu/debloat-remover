<ui:FluentWindow x:Class="DebloatManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:DebloatManager"
                 xmlns:conv="clr-namespace:DebloatManager.Converters"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="DebloatManager" Height="720" Width="1000" MinHeight="480" MinWidth="760"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized"
                 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 Icon="/Assets/app.ico"
                 Background="#FF1B1B1B">
    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrushConverter" />
        <conv:AppTypeToLabelConverter x:Key="AppTypeToLabelConverter" />
        <conv:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter" />

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#FF232323" />
            <Setter Property="Foreground" Value="#FFB8B8B8" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF3DA9FC" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1B1B1B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF262626" />
            <Setter Property="Foreground" Value="#FFB8B8B8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="EllipsisTextBlock" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF2D3B4E" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Title="DebloatManager" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Broom24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Grid.Column="0" Background="#FF1B1B1B" BorderThickness="0" Padding="0">

            <TabItem Header="Installed Apps &amp; Components" Style="{StaticResource DarkTabItem}">
                <Grid Background="#FF1B1B1B">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF232323" Padding="12,10" BorderBrush="#FF303030" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                                 Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibility.Instance}}" />
                                <ui:Button Content="Create Restore Point" Icon="{ui:SymbolIcon Shield24}"
                                           Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Scan" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                           Command="{Binding ScanCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox PlaceholderText="Search apps, publisher, category..." Width="280"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}"
                                          Width="140" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding SelectedRiskFilter}"
                                          Width="120" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#FF202020" Padding="12,7" BorderBrush="#FF2A2A2A" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <CheckBox Content="Group by Category" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IsGroupedByCategory}" Foreground="#FFB8B8B8" Margin="16,0,0,0" />
                            <CheckBox Content="Activity Log" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IsLogVisible}" Foreground="#FFB8B8B8" Margin="16,0,0,0" />

                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Foreground="#FFB8B8B8"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ui:Button Content="Select All Safe" FontSize="12" Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding SelectAllSafeCommand}" />
                            <ui:Button Content="Clear Selection" FontSize="12" Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding ClearSelectionCommand}" />
                            <ui:Button Content="End Task Selected" FontSize="12" Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding EndTaskSelectedCommand}" />
                            <ui:Button Content="Remove Selected" FontSize="12" Padding="10,5" Appearance="Danger"
                                       Command="{Binding RemoveSelectedCommand}" />
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding AppsView}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="40" Margin="0"
                              Background="#FF1B1B1B" Foreground="#FFEAEAEA" BorderThickness="0"
                              RowBackground="#FF1B1B1B" AlternatingRowBackground="#FF212121"
                              HorizontalGridLinesBrush="#FF2E2E2E" VerticalGridLinesBrush="#FF2E2E2E"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                              CellStyle="{StaticResource DarkCell}">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF262626" Padding="10,6" Margin="0,6,0,0">
                                            <TextBlock Foreground="#FFDDDDDD" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanRemove}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="9" Height="9" Fill="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}"
                                                 ToolTip="{Binding Risk}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource AppTypeToLabelConverter}}" Width="0.9*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.3*" ElementStyle="{StaticResource EllipsisTextBlock}" />

                            <DataGridTemplateColumn Header="Risk" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Risk}" Foreground="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}"
                                                   FontWeight="SemiBold" ToolTip="{Binding Notes}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*" ElementStyle="{StaticResource EllipsisTextBlock}" />

                            <DataGridTemplateColumn Header="Actions" Width="172">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="End Task" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                                                       IsEnabled="{Binding CanEndTask}"
                                                       Command="{Binding DataContext.EndTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Content="Remove" Padding="6,3" FontSize="11" Appearance="Danger"
                                                       IsEnabled="{Binding CanRemove}"
                                                       Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                                <Binding Path="TotalCount" />
                                <Binding Path="IsBusy" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <ui:SymbolIcon Symbol="Search24" FontSize="40" Foreground="#FF5A5A5A" HorizontalAlignment="Center" />
                        <TextBlock Text="No items found" Foreground="#FFB8B8B8" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Click Scan to detect installed apps and system components, or adjust your filters."
                                   Foreground="#FF8A8A8A" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Running Processes" Style="{StaticResource DarkTabItem}">
                <Grid Background="#FF1B1B1B">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF232323" Padding="12,10" BorderBrush="#FF303030" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                                 Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibility.Instance}}" />
                                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                           Command="{Binding RefreshProcessesCommand}" />
                            </StackPanel>

                            <ui:TextBox PlaceholderText="Search by process name or PID..." Width="280"
                                        Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Search24}" />
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProcessesView}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="36" Margin="0"
                              Background="#FF1B1B1B" Foreground="#FFEAEAEA" BorderThickness="0"
                              RowBackground="#FF1B1B1B" AlternatingRowBackground="#FF212121"
                              HorizontalGridLinesBrush="#FF2E2E2E" VerticalGridLinesBrush="#FF2E2E2E"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                              CellStyle="{StaticResource DarkCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="Instances" Binding="{Binding InstanceCount}" Width="0.7*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="Memory (MB)" Binding="{Binding TotalMemoryMb}" Width="0.8*" ElementStyle="{StaticResource EllipsisTextBlock}" />
                            <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="3*" ElementStyle="{StaticResource EllipsisTextBlock}" />

                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="End Task" Padding="8,4" FontSize="12" Appearance="Danger"
                                                   Command="{Binding DataContext.EndProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Grid.Column="1" Width="300" Background="#FF202020"
                BorderBrush="#FF2A2A2A" BorderThickness="1,0,0,0"
                Visibility="{Binding IsLogVisible, Converter={x:Static local:BoolToVisibility.Instance}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6" LastChildFill="False">
                    <TextBlock Text="Activity Log" Foreground="#FFDDDDDD" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button DockPanel.Dock="Right" Content="Open Log Folder" FontSize="11" Padding="8,4"
                               Command="{Binding OpenLogFolderCommand}" />
                </DockPanel>
                <ListBox ItemsSource="{Binding ActivityLog}" Background="Transparent" BorderThickness="0" Margin="4,0,4,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FFB8B8B8" FontSize="11" TextWrapping="Wrap" Margin="6,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF232323" Padding="12,8" BorderBrush="#FF303030" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#FFB8B8B8"
                           Text="{Binding TotalCount, StringFormat='{}{0} items'}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Foreground="#FFB8B8B8"
                           Text="{Binding RunningCount, StringFormat='{}{0} running'}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFEAEAEA" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
