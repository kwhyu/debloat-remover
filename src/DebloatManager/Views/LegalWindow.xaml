<ui:FluentWindow x:Class="DebloatManager.Views.LegalWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Legal" Width="820" Height="620" MinWidth="600" MinHeight="400"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False"
                 Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Title="Legal and risks" ShowMinimize="False" ShowMaximize="False" />

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,4,6,10">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" Margin="6,8,0,0" TextWrapping="Wrap" />
            <ListBox x:Name="DocumentList" DisplayMemberPath="Title" SelectionChanged="OnDocumentChanged"
                     Background="Transparent" BorderThickness="0" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" Margin="4,4,12,12" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
        </Border>
    </Grid>
</ui:FluentWindow>
